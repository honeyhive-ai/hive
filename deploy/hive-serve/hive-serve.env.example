# Environment for the hive-serve user unit. Copy to
# ~/.config/hive-serve/hive-serve.env (mode 0600) and fill in. systemd does not
# expand ~ or $HOME here: use absolute paths.

# ── Identity + workspace ────────────────────────────────────────────────────
# Where this box's identity (device keys), hive.db, serve.token and
# repo-bindings.toml live. Keys never leave this directory.
HIVE_DATA_DIR=/home/YOU/.hive-serve
# The workspace connection (relay URL, room, E2EE key, relay token) is written
# to $HIVE_DATA_DIR/config.toml by `hive enroll`; only override it here if needed.
# HIVE_RELAY_URL=
# HIVE_RELAY_ACCESS_TOKEN=
# HIVE_WORKSPACE=
# HIVE_WORKSPACE_KEY=

# ── API ─────────────────────────────────────────────────────────────────────
# This box's Tailscale IP (tailscale ip -4) and a port. Loopback, LAN and
# tailnet addresses only; 0.0.0.0 is refused.
HIVE_SERVE_LISTEN=100.x.y.z:8787
# Label other members see for this host, and the name phone messages post as.
HIVE_SERVE_LABEL=sff
HIVE_SERVE_NAME=Phone
# Optional: the URL the phone should use if it differs from http://<listen>
# (e.g. a MagicDNS name: http://sff.your-tailnet.ts.net:8787).
# HIVE_SERVE_PUBLIC_URL=
# Optional: whose box this is (their display name or actor id). serve then asks
# to become one of their own devices: it prints an enrollment code (also
# `hive serve enroll`) to approve on their desktop (Settings > Account > My
# devices). Once approved, everything the phone does is authored as them.
# HIVE_SERVE_OWNER=Alex
# Optional: route phone messages that @mention nobody to this agent.
# HIVE_SERVE_DEFAULT_AGENT=coder
# Optional: approving a file-diff proposal from the phone also applies it to the
# bound checkout here (commit on hive/chat/<id>), like the desktop's Implement.
# HIVE_SERVE_APPLY_ON_APPROVE=1
# Optional: the theme a phone set to "Match host" follows (GET /v1/appearance).
# Without these, serve reads the desktop app's saved theme on this machine, if
# the app is installed here. Palette: pollen, studio, harbor, slate, meadow or
# obsidian. Mode: auto, light or dark.
# HIVE_SERVE_PALETTE=pollen
# HIVE_SERVE_APPEARANCE=auto

# ── Notifications (self-hosted ntfy) ────────────────────────────────────────
HIVE_NTFY_URL=http://100.x.y.z:8095
HIVE_NTFY_TOPIC=your-topic
# HIVE_NTFY_TOKEN=

# ── Dashboard (the app's dashboard tab; docs/dashboard.md) ─────────────────
# Every dashboard starts with a built-in Hive section (agents, proposals,
# workflows, turns, this host). More panels come from dashboard.toml in
# HIVE_DATA_DIR (see dashboard.toml.example). Without that file, setting
# HIVE_PROMETHEUS_URL adds a generated lab dashboard below the Hive section.
HIVE_PROMETHEUS_URL=http://127.0.0.1:9090
# HIVE_DASHBOARD_FILE=/var/lib/hive/dashboard.toml
# Temperatures in the generated default (and the deprecated /v1/lab/status):
# HIVE_LAB_TEMPS=CPU=max(node_hwmon_temp_celsius);GPU=max(lhm_gpuamd_temperature_celsius)

# ── Agent turns ─────────────────────────────────────────────────────────────
# Checkouts agents may work on; bind one with `hive bind-repo <name>`.
HIVE_REPOS_DIR=/home/YOU/repos
# Built-in file tools for local model runtimes (default on). run_command is off
# unless enabled, and even then only runs inside the turn's isolated worktree.
# HIVE_BUILTIN_TOOLS=1
# HIVE_BUILTIN_RUN_COMMAND=0
# MCP servers for agent turns (TOML, see README); tokens come from env vars it names.
# HIVE_MCP_CONFIG=/home/YOU/.config/hive-serve/mcp.toml
# RDNAMCP_TOKEN=
# Minimum role of the message author before tools run (default contributor).
# HIVE_MCP_MIN_ROLE=contributor
# Keys for workspace runtimes that use a secretRef: HIVE_WS_SECRET_<ref>=...
